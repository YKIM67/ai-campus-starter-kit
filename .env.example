# Copy to .env and fill in. Never commit real values.
# Admin token for privileged endpoints (POST /api/items).
# If unset, a random token is generated at startup (admin endpoints effectively locked).
ADMIN_MASTER_TOKEN=
# SQLite database file path
DB_FILE=service.db
# SQLite busy timeout in milliseconds
SQLITE_BUSY_TIMEOUT_MS=5000
# PBKDF2-HMAC-SHA256 iteration count for password hashing
PBKDF2_ITERATIONS=200000
